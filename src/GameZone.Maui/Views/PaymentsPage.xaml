<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameZone.Maui.Views.PaymentsPage"
             Title="Payments">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="10">
        <HorizontalStackLayout>
            <CheckBox IsChecked="{Binding PendingOnly}" CheckedChanged="OnFilterChanged" Color="{StaticResource Accent}" />
            <Label Text="Pending only" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <Label Grid.Row="1" Text="{Binding Error}" TextColor="{StaticResource Danger}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Payments}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource Card}" Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ClientName}" FontAttributes="Bold" />
                            <Label Text="{Binding Amount, StringFormat='Rs {0:N2}'}" TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding StatusText}" TextColor="{StaticResource Muted}" />
                            <Button Text="Mark paid" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CollectCommand}" CommandParameter="{Binding .}" HeightRequest="40" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
