<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameZone.Maui.Views.PaymentFormPage"
             Title="Record Payment">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry Placeholder="Amount" Text="{Binding AmountText}" Keyboard="Numeric" />
        <Picker Title="Method" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" />
        <Entry Placeholder="Reference" Text="{Binding Reference}" />
        <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" />
        <Button Text="Save" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>
