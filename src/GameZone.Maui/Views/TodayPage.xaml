<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameZone.Maui.Views.TodayPage"
             Title="Today's Clients">
    <CollectionView ItemsSource="{Binding Sessions}" Margin="16">
        <CollectionView.Header>
            <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" />
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border BackgroundColor="{StaticResource Card}" Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout>
                        <Label Text="{Binding ClientName}" FontAttributes="Bold" />
                        <Label Text="{Binding GamingItemName}" TextColor="{StaticResource Accent}" />
                        <Label Text="{Binding StatusText}" TextColor="{StaticResource Muted}" />
                        <Label Text="{Binding Amount, StringFormat='Rs {0:N2}'}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
