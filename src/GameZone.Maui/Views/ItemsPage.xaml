<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameZone.Maui.Views.ItemsPage"
             Title="Gaming Items">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="10">
        <VerticalStackLayout Spacing="8">
            <Entry Placeholder="Item name" Text="{Binding Name}" />
            <Entry Placeholder="Rate per hour" Text="{Binding RateText}" Keyboard="Numeric" />
            <Button Text="Save item" Command="{Binding SaveCommand}" />
            <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" />
        </VerticalStackLayout>
        <Label Grid.Row="1" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource Card}" Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayLabel}" FontAttributes="Bold" />
                            <Label Text="{Binding StatusText}" TextColor="{StaticResource Muted}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Edit" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" HeightRequest="40" Style="{StaticResource GhostButton}" />
                                <Button Text="On/Off" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleCommand}" CommandParameter="{Binding .}" HeightRequest="40" Style="{StaticResource GhostButton}" />
                                <Button Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" HeightRequest="40" Style="{StaticResource GhostButton}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
