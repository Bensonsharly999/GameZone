<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameZone.Maui.Views.ClientFormPage"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry Placeholder="Name" Text="{Binding Name}" />
        <Entry Placeholder="Phone" Text="{Binding Phone}" Keyboard="Telephone" />
        <Entry Placeholder="Address" Text="{Binding Address}" />
        <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" />
        <Button Text="Save" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>
